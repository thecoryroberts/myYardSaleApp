@page
@model myYardSale.Web.Areas.Identity.Pages.Manage.PurchasesModel
@{
    ViewData["Title"] = "My Purchases";
    ViewData["ActivePage"] = "Purchases";
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
}

<h1 class="h3 mb-4"><i class="bi bi-receipt me-2"></i>@ViewData["Title"]</h1>

@if (!Model.Orders.Any())
{
    <div class="empty-state fade-in-up">
        <i class="bi bi-bag display-1 mb-3 text-primary"></i>
        <h3 class="h4 mb-2">No purchases yet</h3>
        <p class="text-muted mb-4">When you buy items, your orders will appear here.</p>
        <a class="btn btn-primary btn-lg" asp-action="Index" asp-controller="Home">
            <i class="bi bi-shop me-2"></i>Browse Listings
        </a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0">Order #</th>
                            <th class="border-0">Date</th>
                            <th class="border-0">Status</th>
                            <th class="border-0">Total</th>
                            <th class="border-0"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td><span class="fw-medium">#@order.Id</span></td>
                                <td>@order.PlacedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @{
                                        var statusClass = order.Status switch
                                        {
                                            "Pending" => "bg-warning",
                                            "Confirmed" => "bg-info",
                                            "Shipped" => "bg-primary",
                                            "Delivered" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass rounded-pill">@order.Status</span>
                                </td>
                                <td class="fw-medium">$@order.TotalAmount.ToString("0.00")</td>
                                <td class="text-end">
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary rounded-pill">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}