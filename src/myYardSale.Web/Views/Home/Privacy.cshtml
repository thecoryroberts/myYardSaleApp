@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card shadow-sm fade-in-up">
    <div class="card-header bg-white py-3">
        <h1 class="h3 mb-0">
            <i class="bi bi-shield-check me-2"></i>@ViewData["Title"]
        </h1>
    </div>
    <div class="card-body">
        <h2 class="h5">Your Privacy Matters</h2>
        <p class="mb-4">At myYardSale, we are committed to protecting your personal information and being transparent about how we collect, use, and protect your data.</p>

        <h3 class="h6 fw-semibold">Information We Collect</h3>
        <ul class="mb-3">
            <li>Account information (name, email, address)</li>
            <li>Listing data you create</li>
            <li>Order and transaction history</li>
            <li>Communication preferences</li>
        </ul>

        <h3 class="h6 fw-semibold">How We Use Your Information</h3>
        <ul class="mb-3">
            <li>To facilitate local marketplace transactions</li>
            <li>To communicate order updates and status</li>
            <li>To improve our services and user experience</li>
            <li>To prevent fraud and ensure platform safety</li>
        </ul>

        <h3 class="h6 fw-semibold">Data Protection</h3>
        <p class="mb-3">We implement industry-standard security measures including encryption, secure authentication, and regular security audits to protect your information.</p>

        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Note:</strong> This is a placeholder privacy policy. Please consult with a legal professional to ensure compliance with applicable regulations like GDPR, CCPA, or other privacy laws for your jurisdiction.
        </div>
    </div>
</div>