@model myYardSale.Web.Models.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    var metaDescription = Model.Description?.Length > 160 ? Model.Description[..157] + "..." : Model.Description;
    ViewData["Description"] = metaDescription;
    ViewData["OgImage"] = Model.Images.FirstOrDefault()?.StoragePath;
}

<div class="card shadow-sm fade-in-up">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 mb-1">@Model.Title</h1>
                <p class="text-muted mb-0">
                    <i class="bi bi-tag me-1"></i>@Model.Category
                </p>
            </div>
            <span class="badge bg-primary fs-6">@Model.Status</span>
        </div>
    </div>

    <div class="card-body">
        @if (Model.Images.Any())
        {
            <div class="detail-image-grid mb-4">
                @for (int i = 0; i < Model.Images.Count; i++)
                {
                    <img src="@Model.Images[i].StoragePath"
                         class="img-fluid cursor-pointer listing-thumb"
                         alt="@Model.Images[i].AltText"
                         loading="lazy"
                         data-full="@Model.Images[i].StoragePath"
                         data-index="@i"
                         style="height:140px; width:100%; object-fit:cover;" />
                }
            </div>
        }
        else
        {
            <div class="bg-light rounded mb-4 d-flex align-items-center justify-content-center" style="height: 200px;">
                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
            </div>
        }

        <div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-body p-0 text-center">
                        <img id="lightboxImage" src="" alt="" class="img-fluid rounded" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <div>
                <span class="text-muted small text-uppercase fw-semibold">Price</span>
                <div class="detail-price">
                    <span class="currency">$</span>@Model.Price.ToString("0.00")
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="Add" asp-controller="Cart" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="listingId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-cart-plus me-2"></i>Add to Cart
                </button>
            </form>
            @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Seller")))
            {
                <a class="btn btn-outline-secondary btn-lg" asp-action="Edit" asp-route-id="@Model.Id">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" 
                  onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');">
                <button type="submit" class="btn btn-outline-danger btn-lg">
                    <i class="bi bi-trash me-2"></i>Delete
                </button>
            </form>
            }
            <a class="btn btn-outline-light btn-lg" asp-action="Index">
                <i class="bi bi-arrow-left me-2"></i>Back to Listings
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const modalEl = document.getElementById('lightboxModal');
            const img = document.getElementById('lightboxImage');
            if (!modalEl || !img) return;

            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);

            document.querySelectorAll('.listing-thumb').forEach(function(el) {
                el.addEventListener('click', function() {
                    img.src = this.dataset.full || this.src;
                    bsModal.show();
                });
            });

            modalEl.addEventListener('hidden.bs.modal', function() {
                img.src = '';
            });
        })();
    </script>
}
