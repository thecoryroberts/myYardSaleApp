@model myYardSale.Web.Models.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="card shadow-sm fade-in-up">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 mb-1">@Model.Title</h1>
                <p class="text-muted mb-0">
                    <i class="bi bi-tag me-1"></i>@Model.Category
                </p>
            </div>
            <span class="badge bg-primary fs-6">@Model.Status</span>
        </div>
    </div>

    <div class="card-body">
        @if (Model.Images.Any())
        {
            <div id="listingCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner rounded">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Images[i].StoragePath" class="d-block w-100" alt="@Model.Images[i].AltText" style="max-height: 400px; object-fit: cover;" loading="lazy" />
                        </div>
                    }
                </div>
                @if (Model.Images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="bg-light rounded mb-4 d-flex align-items-center justify-content-center" style="height: 250px;">
                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
        }

        <p class="lead mb-4">@Model.Description</p>

        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded mb-4">
            <div>
                <span class="text-muted">Price</span>
                <div class="display-5 fw-bold text-success mb-0">$@Model.Price.ToString("0.00")</div>
            </div>
            <i class="bi bi-currency-dollar text-success" style="font-size: 3rem; opacity: 0.2;"></i>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <form asp-action="Add" asp-controller="Cart" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="listingId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-cart-plus me-2"></i>Add to Cart
                </button>
            </form>
            <a class="btn btn-outline-secondary btn-lg" asp-action="Edit" asp-route-id="@Model.Id">
                <i class="bi bi-pencil me-2"></i>Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" 
                  onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-lg">
                    <i class="bi bi-trash me-2"></i>Delete
                </button>
            </form>
            <a class="btn btn-outline-light btn-lg" asp-action="Index">
                <i class="bi bi-arrow-left me-2"></i>Back to Listings
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-scroll to top on carousel image change
        document.querySelector('.carousel')?.addEventListener('slide.bs.carousel', function() {
            window.scrollBy(0, 0);
        });
    </script>
}