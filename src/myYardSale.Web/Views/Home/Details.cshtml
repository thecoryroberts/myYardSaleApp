@model myYardSale.Web.Models.ListingDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h1 class="h3 mb-1">@Model.Title</h1>
                <p class="text-muted mb-0">@Model.Category</p>
            </div>
            <span class="badge bg-primary">@Model.Status</span>
        </div>

        @if (Model.Images.Any())
        {
            <div class="row g-2 mb-4">
                @foreach (var image in Model.Images)
                {
                    <div class="col-md-4">
                        <img src="@image.StoragePath" class="img-fluid rounded" alt="@image.AltText" style="max-height: 300px; object-fit: cover; width: 100%;" />
                    </div>
                }
            </div>
        }

        <p class="lead">@Model.Description</p>
        <p class="fw-bold fs-4">$@Model.Price.ToString("0.00")</p>

        <div class="d-flex gap-2">
            <form asp-action="Add" asp-controller="Cart" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="listingId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">Add to Cart</button>
            </form>
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    </div>
</div>