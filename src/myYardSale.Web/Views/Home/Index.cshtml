@model myYardSale.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Browse Community Listings";
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Find local treasures and community deals</h1>
    <p class="lead text-muted">A production-ready marketplace foundation for yard sales, neighborhood events, and local pickups.</p>
</div>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-8">
        <label for="searchTerm" class="form-label">Search listings</label>
        <input id="searchTerm" name="searchTerm" class="form-control" value="@Model.SearchTerm" placeholder="Search by title, description, or category" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>
</form>

@if (!Model.Listings.Any())
{
    <div class="alert alert-info">No listings match your search.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@listing.Id" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(listing.ThumbnailUrl))
                        {
                            <img src="@listing.ThumbnailUrl" class="card-img-top" alt="@listing.Title" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-muted">No image</span>
                            </div>
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0">@listing.Title</h5>
                                <span class="badge bg-secondary">@listing.Category</span>
                            </div>
                            <p class="card-text">@listing.Description</p>
                            <p class="fw-bold mb-0">$@listing.Price.ToString("0.00")</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}