@model myYardSale.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Browse Community Listings";
}

<div class="hero-section mb-5">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Find Local Treasures</h1>
        <p class="lead mb-0">Discover amazing deals from your neighbors and local yard sales. Pickup directly from sellers!</p>
    </div>
</div>

<form method="get" class="card border-0 shadow-sm mb-4 fade-in-up filter-bar">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-5 col-lg-6">
                <label for="searchTerm" class="form-label fw-medium mb-1">Search listings</label>
                <input id="searchTerm" name="searchTerm" class="form-control form-control-lg"
                       value="@Model.SearchTerm" placeholder="Search by title, description, or category..." />
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <label for="categoryId" class="form-label fw-medium mb-1">Category</label>
                <select id="categoryId" name="categoryId" class="form-select form-select-lg">
                    <option value="">All categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Value" selected="@(Model.CategoryId.HasValue && Model.CategoryId.ToString() == cat.Value)">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <label for="sortBy" class="form-label fw-medium mb-1">Sort by</label>
                <select id="sortBy" name="sortBy" class="form-select form-select-lg">
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="title" selected="@(Model.SortBy == "title")">Title A–Z</option>
                </select>
            </div>
            <div class="col-12 d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-search me-2"></i>Search
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue || Model.SortBy != "newest")
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-circle me-2"></i>Clear filters
                    </a>
                }
                @if (Model.TotalResults > 0)
                {
                    <span class="text-muted ms-auto d-none d-sm-block">
                        <i class="bi bi-list-ul me-1"></i>@Model.TotalResults listing@(Model.TotalResults == 1 ? "" : "s") found
                    </span>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.Listings.Any())
{
    <div class="empty-state fade-in-up">
        <i class="bi bi-emoji-frown display-1 mb-3"></i>
        <h3 class="h4">No listings found</h3>
        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Seller")))
        {
            <p class="text-muted">Try adjusting your search or <a asp-action="Create" class="text-decoration-none">create a listing</a> to get started.</p>
        }
        else
        {
            <p class="text-muted">Try adjusting your search to find what you're looking for.</p>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 fade-in-up">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@listing.Id" class="text-decoration-none">
                    <div class="card h-100 listing-card">
                        @if (!string.IsNullOrEmpty(listing.ThumbnailUrl))
                        {
                            <img src="@listing.ThumbnailUrl" class="card-img-top" alt="@listing.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0 text-truncate">@listing.Title</h5>
                                <span class="badge bg-primary rounded-pill">@listing.Category</span>
                            </div>
                            <p class="card-text flex-grow-1">@listing.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="price-badge rounded-pill">$@listing.Price.ToString("0.00")</span>
                                <i class="bi bi-arrow-right text-primary"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@{
    var totalPages = (int)Math.Ceiling(Model.TotalResults / (double)Model.PageSize);
}

@if (totalPages > 1)
{
    <nav aria-label="Listing pagination" class="mt-4 fade-in-up">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-page="@(Model.Page - 1)">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-page="@(Model.Page + 1)">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        // Stagger card animations
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.listing-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = (index * 50) + 'ms';
            });
        });
    </script>
}
