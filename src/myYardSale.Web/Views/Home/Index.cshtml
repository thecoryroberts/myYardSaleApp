@model myYardSale.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "Browse Community Listings";
}

<div class="hero-section mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="mb-1">Find Local Treasures</h1>
            <p class="lead mb-0">Discover amazing deals from your neighbors and local yard sales.</p>
        </div>
        <i class="bi bi-shop d-none d-md-block" style="font-size: 3rem; opacity: .15;"></i>
    </div>
</div>

<form method="get" class="filter-bar p-3 mb-4 fade-in-up">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5 col-lg-6">
            <label for="searchTerm" class="form-label">Search</label>
            <input id="searchTerm" name="searchTerm" class="form-control"
                   value="@Model.SearchTerm" placeholder="Search listings..." />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label for="categoryId" class="form-label">Category</label>
            <select id="categoryId" name="categoryId" class="form-select">
                <option value="">All</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Value" selected="@(Model.CategoryId.HasValue && Model.CategoryId.ToString() == cat.Value)">@cat.Text</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2 col-lg-2">
            <label for="sortBy" class="form-label">Sort</label>
            <select id="sortBy" name="sortBy" class="form-select">
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Low Price</option>
                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">High Price</option>
                <option value="title" selected="@(Model.SortBy == "title")">A–Z</option>
            </select>
        </div>
        <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>Search</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue || Model.SortBy != "newest")
            {
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    @if (Model.TotalResults > 0)
    {
        <div class="mt-2 small text-muted">@Model.TotalResults listing@(Model.TotalResults == 1 ? "" : "s") found</div>
    }
</form>

@if (!Model.Listings.Any())
{
    <div class="empty-state fade-in-up">
        <i class="bi bi-emoji-frown display-1 mb-3"></i>
        <h3 class="h4">No listings found</h3>
        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Seller")))
        {
            <p class="text-muted">Try adjusting your search or <a asp-action="Create" class="text-decoration-none">create a listing</a> to get started.</p>
        }
        else
        {
            <p class="text-muted">Try adjusting your search to find what you're looking for.</p>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 fade-in-up">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@listing.Id" class="text-decoration-none">
                    <div class="card h-100 listing-card">
                        @if (!string.IsNullOrEmpty(listing.ThumbnailUrl))
                        {
                            <img src="@listing.ThumbnailUrl" class="card-img-top" alt="@listing.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0 text-truncate">@listing.Title</h5>
                                <span class="badge bg-primary rounded-pill">@listing.Category</span>
                            </div>
                            <p class="card-text flex-grow-1">@listing.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="price-badge rounded-pill">$@listing.Price.ToString("0.00")</span>
                                <i class="bi bi-arrow-right text-primary"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@{
    var totalPages = (int)Math.Ceiling(Model.TotalResults / (double)Model.PageSize);
}

@if (totalPages > 1)
{
    <nav aria-label="Listing pagination" class="mt-4 fade-in-up">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-page="@(Model.Page - 1)">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-page="@(Model.Page + 1)">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        (function() {
            const form = document.querySelector('.filter-bar');
            if (!form) return;

            const searchInput = form.querySelector('input[name="searchTerm"]');
            const categorySelect = form.querySelector('select[name="categoryId"]');
            const sortSelect = form.querySelector('select[name="sortBy"]');

            // Live filter on change for selects
            [categorySelect, sortSelect].forEach(function(el) {
                if (!el) return;
                el.addEventListener('change', function() {
                    form.submit();
                });
            });

            // Debounced search
            let searchTimer;
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(function() {
                        form.submit();
                    }, 350);
                });
            }

            // Stagger card animations
            document.querySelectorAll('.listing-card').forEach(function(card, index) {
                card.style.animationDelay = (index * 50) + 'ms';
            });
        })();
    </script>
}
