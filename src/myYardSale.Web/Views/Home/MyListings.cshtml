@model myYardSale.Web.Models.HomeViewModel

@{
    ViewData["Title"] = "My Listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 animate-fade-in-up">
        <i class="bi bi-box me-2"></i>My Listings
    </h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create Listing
    </a>
</div>

@if (!Model.Listings.Any())
{
    <div class="empty-state animate-fade-in-up">
        <i class="bi bi-box empty-state-icon text-muted"></i>
        <h3 class="h4 mb-2">No listings yet</h3>
        <p class="text-muted mb-3">You haven't created any listings.</p>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Create Your First Listing
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 animate-fade-in-up">
        @foreach (var listing in Model.Listings)
        {
            <div class="col">
                <a asp-action="Details" asp-route-id="@listing.Id" class="text-decoration-none card-hover">
                    <div class="card h-100 listing-card">
                        @if (!string.IsNullOrEmpty(listing.ThumbnailUrl))
                        {
                            <img src="@listing.ThumbnailUrl" class="card-img-top" alt="@listing.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center">
                                <i class="bi bi-image listing-card-image-placeholder"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0 text-truncate">@listing.Title</h5>
                                <span class="badge bg-primary rounded-pill">@listing.Category</span>
                            </div>
                            <p class="card-text flex-grow-1">@listing.Description</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="price-badge rounded-pill">$@listing.Price.ToString("0.00")</span>
                                <i class="bi bi-arrow-right text-primary"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

