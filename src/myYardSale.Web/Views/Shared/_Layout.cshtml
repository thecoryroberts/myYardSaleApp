<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Local marketplace for yard sales, neighborhood events, and community pickups. Find treasures in your area!" />
    <meta name="theme-color" content="#2563eb" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "myYardSale") - Local Community Marketplace" />
    <meta property="og:description" content="Discover amazing deals from your neighbors and local yard sales. Pickup directly from sellers!" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>@ViewData["Title"] - myYardSale</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable btn btn-primary m-2" href="#mainContent">Skip to main content</a>
    
    <header>
        <nav class="navbar navbar-expand-lg" role="navigation" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index" aria-label="myYardSale Home">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="me-2" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="2" />
                    </svg>
                    myYardSale
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-lg-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" 
                               aria-current="@(ViewData["ActiveNav"]?.ToString() == "Browse" ? "page" : "false")">
                                <i class="bi bi-house-door me-1" aria-hidden="true"></i>Browse
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Seller")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="MyListings"
                                   aria-current="@(ViewData["ActiveNav"]?.ToString() == "MyListings" ? "page" : "false")">
                                    <i class="bi bi-box me-1" aria-hidden="true"></i>My Listings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Create"
                                   aria-current="@(ViewData["ActiveNav"]?.ToString() == "Create" ? "page" : "false")">
                                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create Listing
                                </a>
                            </li>
                        }
                        
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy"
                               aria-current="@(ViewData["ActiveNav"]?.ToString() == "Privacy" ? "page" : "false")">
                                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Privacy
                            </a>
                        </li>
                        
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index"
                                   aria-current="@(ViewData["ActiveNav"]?.ToString() == "Admin" ? "page" : "false")">
                                    <i class="bi bi-gear me-1" aria-hidden="true"></i>Admin Panel
                                </a>
                            </li>
                        }
                    </ul>
                    
                     <button class="dark-mode-toggle me-2" aria-label="Toggle dark mode" title="Toggle dark mode">
                         <i class="bi bi-moon"></i>
                     </button>
                     
                     <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <main id="mainContent" role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer" role="contentinfo">
        <div class="container">
            <div class="footer-content">
                <div class="footer-copyright">
                    &copy; 2026 - myYardSale - Your local marketplace
                </div>
                <div class="footer-links">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js" 
            integrity="sha384-+AT5qByK2BR0u5WzMGY5l5I2u7M90zMmLPrCv5/lLyzH0jGpxQAkGWJomK7bPGP" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>