@model List<(string Label, string? Url)>

@if (Model?.Any() == true)
{
    <nav aria-label="Breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-area="" asp-controller="Home" asp-action="Index" aria-label="Home">
                    <i class="bi bi-house-door me-1" aria-hidden="true"></i>Home
                </a>
            </li>
            @foreach (var crumb in Model)
            {
                if (!string.IsNullOrEmpty(crumb.Url))
                {
                    <li class="breadcrumb-item">
                        <a href="@crumb.Url">@crumb.Label</a>
                    </li>
                }
                else
                {
                    <li class="breadcrumb-item active" aria-current="page">
                        @crumb.Label
                    </li>
                }
            }
        </ol>
    </nav>
}