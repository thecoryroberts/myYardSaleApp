@using Microsoft.AspNetCore.Identity
@using myYardSale.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item me-2 position-relative">
            <a class="nav-link" asp-controller="Cart" asp-action="Index" title="Shopping Cart">
                <i class="bi bi-cart3 fs-5"></i>
                @await Component.InvokeAsync("CartCount")
                <span class="d-lg-none ms-1">Cart</span>
            </a>
        </li>

        <li class="nav-item me-2">
            <a class="nav-link @(ViewData["ActiveNav"]?.ToString() == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index" title="My Orders">
                <i class="bi bi-box-seam fs-5"></i>
                <span class="d-lg-none ms-1">Orders</span>
            </a>
        </li>

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" id="userDropdown" role="button" 
               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="user-avatar" aria-hidden="true">
                    @(UserManager.GetUserName(User) is { Length: > 0 } name ? name[..1].ToUpper() : "U")
                </span>
                <span class="d-none d-lg-inline">@UserManager.GetUserName(User)</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border" aria-labelledby="userDropdown">
                <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i>My Account
                    </a>
                </li>
                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i>My Orders</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm">
                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </a>
        </li>
    }
</ul>