@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state animate-fade-in-up">
    <i class="bi bi-exclamation-octagon display-1 mb-3 text-danger"></i>
    <h2 class="h3 mb-3">Something went wrong</h2>
    <p class="text-muted mb-4">We apologize for the inconvenience. An unexpected error occurred while processing your request.</p>
    
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    
    <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
        <i class="bi bi-arrow-left me-2"></i>Go Back
    </a>
    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">
        <i class="bi bi-house-door me-2"></i>Go Home
    </a>
</div>