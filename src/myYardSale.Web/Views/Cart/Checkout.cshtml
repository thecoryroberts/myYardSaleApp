@model myYardSale.Web.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1 class="h3 mb-4">Checkout</h1>

<form asp-action="Checkout" method="post" class="card shadow-sm p-4">
    @Html.AntiForgeryToken()

    <h5 class="mb-3">Order Summary</h5>

    <table class="table table-sm">
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Quantity</td>
                    <td>$@item.UnitPrice.ToString("0.00")</td>
                    <td>$@item.Subtotal.ToString("0.00")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total:</th>
                <th>$@Model.Total.ToString("0.00")</th>
            </tr>
        </tfoot>
    </table>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Delivery Notes (optional)</label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions for pickup..."></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Place Order</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Cart</a>
    </div>
</form>