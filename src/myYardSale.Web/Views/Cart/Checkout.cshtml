@model myYardSale.Web.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<h1 class="h3 mb-4 fade-in-up">
    <i class="bi bi-credit-card me-2"></i>Checkout
</h1>

<form asp-action="Checkout" method="post" class="card shadow-sm mb-4 fade-in-up">
    @Html.AntiForgeryToken()

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-receipt me-2"></i>Order Summary
        </h5>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" alt="@item.Title" class="me-2 rounded" style="height: 40px; width: 40px; object-fit: cover;" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="me-2 bg-light rounded d-flex align-items-center justify-content-center" style="height: 40px; width: 40px;">
                                            <i class="bi bi-image text-muted small"></i>
                                        </div>
                                    }
                                    @item.Title
                                </div>
                            </td>
                            <td>@item.Quantity</td>
                            <td>$@item.UnitPrice.ToString("0.00")</td>
                            <td class="fw-medium">$@item.Subtotal.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th class="text-success">$@Model.Total.ToString("0.00")</th>
                        </tr>
                    </tfoot>
            </table>
        </div>
    </div>

    <div class="card-body">
        <div class="mb-3">
            <label asp-for="Notes" class="form-label fw-medium">
                <i class="bi bi-chat-text me-1"></i>Delivery Notes (optional)
            </label>
            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions for pickup (time, location, etc.)..."></textarea>
            <div class="form-text">Let the seller know when and where you'd like to pick up your items.</div>
        </div>

        <div class="d-flex gap-2 flex-wrap fade-in-up">
            <button type="submit" class="btn btn-success btn-lg px-4">
                <i class="bi bi-check-circle me-2"></i>Place Order
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left me-2"></i>Back to Cart
            </a>
        </div>
    </div>
</form>