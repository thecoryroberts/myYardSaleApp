@model myYardSale.Web.Models.ListingFormViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<div class="card shadow-sm fade-in-up form-page">
    <div class="card-header bg-white py-3">
        <h1 class="h3 mb-0">
            <i class="bi bi-pencil-square me-2"></i>Edit Listing
        </h1>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card-body">
    <div class="mb-3">
        <label asp-for="Title" class="form-label fw-medium">
            <i class="bi bi-card-heading me-1"></i>Title
        </label>
        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g., Vintage Wooden Chair" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-medium">
            <i class="bi bi-text-paragraph me-1"></i>Description
        </label>
        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Condition, size, color, any flaws..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Price" class="form-label fw-medium">
                <i class="bi bi-tag me-1"></i>Price
            </label>
            <div class="input-group input-group-lg">
                <span class="input-group-text">$</span>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
            </div>
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Status" class="form-label fw-medium">
                <i class="bi bi-circle me-1"></i>Status
            </label>
            <select asp-for="Status" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<ListingStatus>()"></select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label fw-medium">
            <i class="bi bi-collection me-1"></i>Category
        </label>
        <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="Model.Categories">
            <option value="">Select a category</option>
        </select>
    </div>

    @if (Model.ExistingImages.Any())
    {
        <div class="mb-3">
            <label class="form-label fw-medium">
                <i class="bi bi-images me-1"></i>Current Images
            </label>
            <div class="row g-3">
                @foreach (var image in Model.ExistingImages)
                {
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="position-relative">
                                <img src="@image.StoragePath" class="img-thumbnail w-100 object-fit-cover rounded admin-edit-image" alt="@image.AltText" loading="lazy" />
                            <form asp-action="DeleteImage" asp-controller="Admin" asp-route-imageId="@image.Id" asp-route-listingId="@Model.Id" method="post" class="position-absolute top-0 end-0 m-1" onsubmit="return confirm('Remove this image?');">
                                @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger rounded-circle p-0 admin-delete-image-btn" aria-label="Remove image">
                                    <i class="bi bi-x"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="ImageFiles" class="form-label fw-medium">
            <i class="bi bi-images me-1"></i>Photos
        </label>
        <input asp-for="ImageFiles" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
        <div class="form-text">
            <i class="bi bi-info-circle me-1"></i>Add more photos. Supported formats: JPG, PNG, GIF, WebP. Max size per file: 5 MB.
        </div>
    </div>

    <hr class="my-4" />
    
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-save me-2"></i>Save Changes
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-x-circle me-2"></i>Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}