@model myYardSale.Web.Models.ListingFormViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<h1 class="mb-4">Edit Listing</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ListingStatus>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories">
            <option value="">-- Select Category --</option>
        </select>
    </div>

    @if (Model.ExistingImages.Any())
    {
        <div class="mb-3">
            <label class="form-label">Existing Images</label>
            <div class="row g-2">
                @foreach (var image in Model.ExistingImages)
                {
                    <div class="col-md-3">
                        <div class="position-relative">
                            <img src="@image.StoragePath" class="img-thumbnail" alt="@image.AltText" style="height: 120px; width: 100%; object-fit: cover;" />
                            <form asp-action="DeleteImage" asp-controller="Admin" asp-route-imageId="@image.Id" asp-route-listingId="@Model.Id" method="post" class="position-absolute top-0 end-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this image?');">&times;</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Add Image</label>
        <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" />
        <div class="form-text">Optional. Supported formats: JPG, PNG, GIF, WebP. Max size: 5 MB.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}