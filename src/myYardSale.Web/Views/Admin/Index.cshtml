@model myYardSale.Web.Models.AdminListingIndexViewModel
@{
    ViewData["Title"] = "Admin Listings";
}

<h1 class="mb-4">Admin Listings</h1>

@if (!Model.Listings.Any())
{
    <div class="alert alert-info">No listings available.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Price</th>
                <th>Category</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var listing in Model.Listings)
            {
                <tr>
                    <td>@listing.Title</td>
                    <td>@listing.Status</td>
                    <td>@listing.Price.ToString("C")</td>
                    <td>@listing.Category</td>
                    <td>@listing.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@listing.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@listing.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this listing?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
