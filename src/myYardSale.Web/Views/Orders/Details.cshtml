@model myYardSale.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<h1 class="h3 mb-4">Order #@Model.Id</h1>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Date:</dt>
                    <dd class="col-sm-8">@Model.PlacedAt.ToString("MMM dd, yyyy h:mm tt")</dd>
                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Status</span></dd>
                    <dt class="col-sm-4">Customer:</dt>
                    <dd class="col-sm-8">@Model.CustomerName</dd>
                </dl>
            </div>
            <div class="col-md-6 text-md-end">
                <h5 class="mb-0">Total: $@Model.TotalAmount.ToString("0.00")</h5>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <p class="text-muted mt-2"><strong>Notes:</strong> @Model.Notes</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="mb-3">Order Items</h5>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Quantity</td>
                        <td>$@item.UnitPrice.ToString("0.00")</td>
                        <td>$@item.Subtotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total:</th>
                    <th>$@Model.TotalAmount.ToString("0.00")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
</div>