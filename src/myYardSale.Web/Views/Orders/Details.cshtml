@model myYardSale.Web.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var statusClass = Model.Status switch
    {
        "Pending" => "bg-warning",
        "Processing" => "bg-info",
        "Completed" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}

<h1 class="h3 mb-4 animate-fade-in-up">
    <i class="bi bi-receipt me-2"></i>Order #@Model.Id
</h1>

<div class="card shadow-sm mb-4 animate-fade-in-up">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>Order Information
            </h5>
            <span class="badge @statusClass rounded-pill fs-6">@Model.Status</span>
        </div>
    </div>
    
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-medium">
                        <i class="bi bi-calendar me-1"></i>Date:
                    </dt>
                    <dd class="col-sm-8">@Model.PlacedAt.ToString("MMM dd, yyyy h:mm tt")</dd>
                    
                    <dt class="col-sm-4 fw-medium">
                        <i class="bi bi-person me-1"></i>Customer:
                    </dt>
                    <dd class="col-sm-8">@(Model.CustomerName ?? "Unknown")</dd>
                </dl>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="bg-light rounded p-3 d-inline-block">
                    <span class="text-muted d-block">Total Amount</span>
                    <span class="display-5 fw-bold text-success">$@Model.TotalAmount.ToString("0.00")</span>
                </div>
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <hr class="my-3" />
            <div>
                <strong class="text-muted">
                    <i class="bi bi-chat-text me-1"></i>Delivery Notes:
                </strong>
                <p class="mb-0 mt-1">@Model.Notes</p>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm animate-fade-in-up">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-box me-2"></i>Order Items
        </h5>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="border-0">Item</th>
                        <th class="border-0">Quantity</th>
                        <th class="border-0">Unit Price</th>
                        <th class="border-0">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-medium">@item.Title</td>
                            <td>@item.Quantity</td>
                            <td>$@item.UnitPrice.ToString("0.00")</td>
                            <td class="fw-medium">$@item.Subtotal.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end fs-5">Total:</th>
                        <th class="fs-5 text-success">$@Model.TotalAmount.ToString("0.00")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<div class="mt-4 animate-fade-in-up">
    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
        <i class="bi bi-arrow-left me-2"></i>Back to Orders
    </a>
</div>
