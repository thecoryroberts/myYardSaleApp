@model myYardSale.Web.Models.OrderIndexViewModel

@{
    ViewData["Title"] = "My Orders";
}

<h1 class="h3 mb-4">My Orders</h1>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">You haven't placed any orders yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Items</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                            <td>@order.PlacedAt.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge bg-primary">@order.Status</span></td>
                            <td>$@order.TotalAmount.ToString("0.00")</td>
                            <td>@order.ItemCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}